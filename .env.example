# 이 파일은 예시다. 실제 값은 .env.local 또는 배포 비밀 설정에 저장한다.
# .env.local을 Git에 포함하지 않는다. 관리자 KEY나 SECRET에는 NEXT_PUBLIC_을 붙이지 않는다.

# 공개 화면은 실데이터만 사용한다. 기존 demo 설정은 실데이터로 해석한다.
DATA_MODE=live
# 기본 운영 저장소는 supabase. 개발용 수집본/기본 5분 정기 수집은 local-snapshot으로 명시한다.
LIVE_DATA_BACKEND=supabase
APP_BASE_URL=http://localhost:3000

# 서울시 원천 API. 사용자 인증키는 비워 두었다.
SEOUL_API_KEY=
SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088

# 공식 HTTPS 제공 여부를 먼저 확인한다.
# HTTP만 사용 가능한 경우 위험을 확인하고 운영자 승인 후 명시적으로 true로 바꾼다.
SEOUL_ALLOW_INSECURE_HTTP=false
# 원천 시간대 공식 근거 미확인. 명시적 해석 기준을 정한 경우에만 설정
SEOUL_SOURCE_TIME_ZONE=

# 공개 조회용 Supabase 클라이언트. 이 프로젝트는 아래 값도 서버에서 읽는다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 기존 설정 호환: SUPABASE_URL 대신 NEXT_PUBLIC_SUPABASE_URL,
# SUPABASE_PUBLISHABLE_KEY 대신 NEXT_PUBLIC_SUPABASE_ANON_KEY를 사용할 수 있다.
# 공개 키 값은 sb_publishable_ 형식이어야 한다. 두 이름에 서로 다른 값을 넣으면 거부한다.

# 수집기 전용. Supabase의 secret key를 사용한다.
# 기존 SUPABASE_SERVICE_ROLE_KEY도 지원한다. 서버 전용이며 브라우저 전달 금지.
SUPABASE_SECRET_KEY=

# 아래 항목은 운영 DB 수집기용이다. 개발용 collector:local은 선택한 저장소로 수집한다.
# Supabase는 5분, local-snapshot은 5분, 10분 또는 30분을 지원한다.
# 활성화 전 사용량, RPC 권한, 운영 URL과 인증 검사를 검증한다.
COLLECTOR_ENABLED=false
COLLECTOR_SECRET=
COLLECTION_INTERVAL_MINUTES=5
MAX_MONITORED_AREAS=20

# 우리 앱의 일일 요청 안전 상한이다. 서울시의 공식 허용량이라는 뜻이 아니다.
# 실제 키의 허용량보다 작거나 같게 조정한다. 재시도도 횟수에 포함한다.
SEOUL_DAILY_CALL_BUDGET=6000
