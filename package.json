{
  "name": "seoul-pulse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:env": "node --conditions=react-server scripts/check-env.ts",
    "check:deployment": "node --conditions=react-server scripts/check-deployment.ts",
    "verify:seoul": "node --conditions=react-server scripts/verify-seoul-api.ts",
    "collect:once": "node --conditions=react-server scripts/collect-once.ts",
    "capture:seoul": "node --conditions=react-server scripts/capture-seoul.ts",
    "collector:local": "node --conditions=react-server scripts/collector-local.ts"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@mui/x-charts": "9.15.0",
    "@next/env": "16.4.5",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
